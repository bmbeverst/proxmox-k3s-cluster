{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "automerge": true,
  "platformAutomerge": true,
  "hostRules": [
    {
      "description": "Authenticate to GitLab container registry for Renovate's docker datasource to list semver tags",
      "matchHost": "https://registry.gitlab.com",
      "hostType": "docker",
      "token": "{{ secrets.RENOVATE_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Major bumps require manual review (never automerge); patch & minor automerge via the global automerge default",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Piraeus operator chart (infra-apps): OCI registry exposes no release timestamp, so use GitHub releases to satisfy minimumReleaseAge/automerge",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "piraeus"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "piraeusdatastore/piraeus-operator",
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm"
    },
    {
      "description": "linstor-cluster chart (infra-apps): OCI registry exposes no release timestamp, so use GitHub releases to satisfy minimumReleaseAge/automerge",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "linstor-cluster"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "piraeusdatastore/helm-charts",
      "extractVersion": "^linstor-cluster-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm"
    },
    {
      "description": "Vints Docker images from private GitLab registry: no minimumReleaseAge (tag age = creation time), only numeric semver tags",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "proxmox-k3s/proxmox-k3s-cluster/vints-server",
        "proxmox-k3s/proxmox-k3s-cluster/vints-backup"
      ],
      "matchFileNames": [
        "pulumi/versions.yaml"
      ],
      "minimumReleaseAge": null,
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Pulumi Kubernetes operator chart (infra-bootstrap): use timestamped GitHub chart releases for Pulumi Operator",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "pulumi-kubernetes-operator"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "pulumi/pulumi-kubernetes-operator",
      "extractVersion": "^pulumi-kubernetes-operator-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/pulumi/versions\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\r?\\n\\s*[A-Za-z0-9_]+:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "customDatasources": {
    "custom-vintagestory": {
      "format": "json",
      "defaultRegistryUrlTemplate": "http://api.vintagestory.at/stable-unstable.json",
      "transformTemplates": [
        "{{#each keys}} {{this}}\n{{/each}}"
      ]
    }
  }
}
