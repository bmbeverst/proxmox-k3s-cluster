{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Majors never automerge; patch and minor do",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "One MR for everything except Helm chart bumps and the versions.yaml deploy pins (those stay one-at-a-time)",
      "matchManagers": [
        "!helmv3"
      ],
      "matchFileNames": [
        "!pulumi/Chart.yaml",
        "!pulumi/versions.yaml"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all-deps"
    },
    {
      "description": "Ghost image: keep the -alpine suffix",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ghost"
      ],
      "versioning": "docker",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+-alpine$/"
    },
    {
      "description": "Piraeus chart: GitHub releases carry the timestamps the OCI registry lacks",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "piraeus"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "piraeusdatastore/piraeus-operator",
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm"
    },
    {
      "description": "linstor-cluster chart: GitHub releases carry the timestamps the OCI registry lacks",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "linstor-cluster"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "piraeusdatastore/helm-charts",
      "extractVersion": "^linstor-cluster-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm"
    },
    {
      "description": "pyproject floors: bump the >= lower bounds",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "PKO chart: GitHub releases carry the timestamps; never automerge (review, then `pulumi up`)",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "pulumi-kubernetes-operator"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "pulumi/pulumi-kubernetes-operator",
      "extractVersion": "^pulumi-kubernetes-operator-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm",
      "automerge": false
    },
    {
      "description": "Mods: no release-age cooldown - the boot smoke is the gate",
      "matchDatasources": [
        "custom.vintagestory_mod_1_22"
      ],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "vints mods: key is the mod's internal Mod ID; datasource is fixed per game minor",
      "managerFilePatterns": [
        "/pulumi/my-apps/containers/server/vintagestory-mods\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)(?<depName>[A-Za-z0-9_.-]+):[ \\t]*\"?(?<currentValue>[0-9]+\\.[0-9]+[^\\s\"#]*)"
      ],
      "autoReplaceStringTemplate": "\n{{{depName}}}: {{{newValue}}}",
      "datasourceTemplate": "custom.vintagestory_mod_1_22",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/pulumi/versions\\.yaml$/",
        "/pulumi/my-apps/containers/server/vintagestory-version\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+).*\\r?\\n\\s*[A-Za-z0-9_]+:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "customDatasources": {
    "custom-vintagestory": {
      "format": "json",
      "defaultRegistryUrlTemplate": "https://api.vintagestory.at/stable-unstable.json",
      "transformTemplates": [
        "{\"releases\": $map($keys($), function($v) {({\"version\": $v})})}"
      ]
    },
    "vintagestory_mod_1_22": {
      "format": "json",
      "defaultRegistryUrlTemplate": "https://mods.vintagestory.at/api/mod/{{{packageName}}}",
      "transformTemplates": [
        "{\"releases\": [$map($filter($.mod.releases, function($r) { $count($filter($r.tags, function($t) { $boolean($match($t, /^1\\.22\\.[0-9]+$/)) })) > 0 }), function($r) { ({\"version\": $r.modversion}) })]}"
      ]
    }
  }
}
