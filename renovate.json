{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "automerge": true,
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Majors never automerge; patch and minor do",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Group non-critical cluster deps into one block: docker deploy pins, selected helm charts, and suc",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "registry.gitlab.com/proxmox-k3s/proxmox-k3s-cluster/vints-server",
        "registry.gitlab.com/proxmox-k3s/proxmox-k3s-cluster/vints-backup",
        "registry.gitlab.com/proxmox-k3s/proxmox-k3s-cluster/paseo",
        "ghcr.io/donkie/spoolman",
        "pulumi/pulumi-python",
        "ghcr.io/favonia/cloudflare-ddns",
        "mcr.microsoft.com/dotnet/runtime",
        "ghost"
      ],
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    },
    {
      "description": "Group non-critical helm chart bumps into one block",
      "matchManagers": [
        "helmv3"
      ],
      "matchDepNames": [
        "kube-state-metrics",
        "victoria-metrics-single",
        "kured",
        "cert-manager",
        "reloader"
      ],
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    },
    {
      "description": "Group system-upgrade-controller (github-releases) into the non-critical block",
      "matchDatasources": [
        "github-releases"
      ],
      "matchDepNames": [
        "rancher/system-upgrade-controller"
      ],
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    },
    {
      "description": "StratumServer/Stratum: auto-update into the non-critical block, no stable-only filter, sha256 refreshed by hand on version change",
      "matchDatasources": [
        "github-releases"
      ],
      "matchDepNames": [
        "StratumServer/Stratum"
      ],
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "minimumReleaseAge": null,
      "priority": 999
    },
    {
      "description": "Big merge set: vintagestory game",
      "matchDatasources": [
        "custom.custom-vintagestory"
      ],
      "matchDepNames": [
        "vintagestory"
      ],
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    },
    {
      "description": "Big merge set: vints mods",
      "matchDatasources": [
        "custom.vintagestory_mods"
      ],
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999,
      "minimumReleaseAge": null
    },
    {
      "description": "Ghost image: keep the -alpine suffix",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ghost"
      ],
      "versioning": "docker",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+-alpine$/",
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    },
    {
      "description": "Cline: weekly bumps (daily upstream); keeps buildcache warm",
      "matchDepNames": [
        "cline"
      ],
      "schedule": [
        "0 1 * * 1"
      ],
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    },
    {
      "description": "pyproject floors: bump the >= lower bounds",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "rangeStrategy": "bump",
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    },
    {
      "description": "PKO chart: NEVER merge - merging makes PKO upgrade itself and wedge the Helm release",
      "matchManagers": [
        "helmv3"
      ],
      "matchDepNames": [
        "pulumi-kubernetes-operator"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "pulumi/pulumi-kubernetes-operator",
      "extractVersion": "^pulumi-kubernetes-operator-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm",
      "automerge": false,
      "addLabels": [
        "DO-NOT-MERGE"
      ],
      "commitMessagePrefix": "DO NOT MERGE -",
      "commitMessageAction": "",
      "commitMessageTopic": "PKO chart newVersion phase",
      "commitMessageExtra": "",
      "commitMessageSuffix": "apply by hand with pulumi",
      "prBodyNotes": [
        "# DO NOT MERGE",
        "Merging this bump makes PKO upgrade its own chart, and that upgrade replaces the operator running it: the Helm release is cancelled mid-flight and left pending-rollback, after which every Helm operation fails with another operation (install/upgrade/rollback) is in progress",
        "Apply it by hand from the dev box instead, then close this MR: cd pulumi/infra-bootstrap pulumi up"
      ]
    },
    {
      "description": "Piraeus chart: GitHub releases carry the timestamps the OCI registry lacks",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "piraeus"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "piraeusdatastore/piraeus-operator",
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm",
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    },
    {
      "description": "linstor-cluster chart: GitHub releases carry the timestamps the OCI registry lacks",
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "linstor-cluster"
      ],
      "matchFileNames": [
        "pulumi/Chart.yaml"
      ],
      "overrideDatasource": "github-releases",
      "overridePackageName": "piraeusdatastore/helm-charts",
      "extractVersion": "^linstor-cluster-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "helm",
      "groupName": "non-critical cluster deps",
      "groupSlug": "non-critical-cluster-deps",
      "priority": 999
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "vints mods: key is the mod's internal Mod ID; datasource is fixed per game minor",
      "managerFilePatterns": [
        "/pulumi/my-apps/containers/server/vintagestory-mods\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)(?<depName>[A-Za-z0-9_.-]+):[ \\t]*\"?(?<currentValue>[0-9]+\\.[0-9]+[^\\s\"#]*)"
      ],
      "autoReplaceStringTemplate": "\n{{{depName}}}: {{{newValue}}}",
      "datasourceTemplate": "custom.vintagestory_mods",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/pulumi/versions\\.yaml$/",
        "/pulumi/my-apps/containers/server/vintagestory-version\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+).*\\r?\\n\\s*[A-Za-z0-9_]+:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "customDatasources": {
    "custom-vintagestory": {
      "format": "json",
      "defaultRegistryUrlTemplate": "https://api.vintagestory.at/stable-unstable.json",
      "transformTemplates": [
        "{\"releases\": $map($keys($), function($v) {({\"version\": $v})})}"
      ]
    },
    "vintagestory_mods": {
      "format": "json",
      "defaultRegistryUrlTemplate": "https://mods.vintagestory.at/api/mod/{{{packageName}}}",
      "transformTemplates": [
        "{\"releases\": [$map($filter($.mod.releases, function($r) { $count($filter($r.tags, function($t) { $boolean($match($t, /^1\\.22\\.[0-9]+$/)) })) > 0 }), function($r) { ({\"version\": $r.modversion}) })]}"
      ]
    }
  }
}